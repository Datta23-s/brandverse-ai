# Copy to .env and fill in. Never commit .env (Rules.md P1).
# Model IDs are NOT configured here — they live only in config/models.yaml (Rules.md P5).

# Supabase. The publishable key is safe in the browser (RLS applies); the secret key bypasses RLS
# and is backend-only — never in frontend code or a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Postgres connection string for the Supabase project (backend, LangGraph checkpointer).
# Not TEST_DATABASE_URL: the database tests drop and recreate a database and must only ever
# point at a throwaway server, never at Supabase.
DATABASE_URL=

GOOGLE_API_KEY=
LITELLM_MASTER_KEY=
# Defaults to redis://127.0.0.1:6379/0 (compose.yaml). Use 127.0.0.1, not localhost (Architecture.md §11).
REDIS_URL=
# Local SearXNG (compose.yaml, docs/searxng.md): http://127.0.0.1:8888
SEARXNG_URL=
LANGGRAPH_STRICT_MSGPACK=true
MAX_COST_PER_RUN_USD=2.50
MAX_LLM_CALLS_PER_RUN=20
