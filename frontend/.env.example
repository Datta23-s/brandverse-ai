# Copy to .env.local. Every variable here reaches the browser (NEXT_PUBLIC_), so NOTHING SECRET
# goes here: the Supabase key is the PUBLISHABLE key (sb_publishable_...), never the secret key
# (Rules.md P2). The app refuses to start with a secret key, and a test checks the built bundle.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
